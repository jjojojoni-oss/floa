# Alamat situs (dipakai untuk metadata & sitemap)
NEXT_PUBLIC_SITE_URL=https://floa.site

# ── Penyimpanan: Supabase (wajib di produksi) ──────────────────────────────
# Jalankan supabase/schema.sql sekali di SQL Editor, lalu isi dua nilai ini
# dari Project Settings → API. Service role key HANYA untuk server; jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=kado

# ── Pembayaran dari Indonesia: BorderPay (QRIS, rupiah) ───────────────────
# Dashboard BorderPay → project → API key. bp_test_... = mode uji (tanpa uang nyata), bp_live_... = asli.
BORDERPAY_API_KEY=
# Dashboard BorderPay → project → webhook. URL: https://<domain>/api/pay/borderpay
# Token verifikasinya (bpt_...) diisi di sini.
BORDERPAY_WEBHOOK_TOKEN=

# ── Pembayaran dari luar negeri: Creem (kartu, dolar AS) ───────────────────
# Dashboard Creem → Developers → API key. Key mode uji memakai test-api.creem.io.
CREEM_API_KEY=
# Buat SATU produk sekali bayar (one-time) berharga USD di Creem dan isi ID-nya (prod_...).
# Harga tiap paket diatur floa per transaksi (src/lib/site.ts), harga produknya sendiri tidak dipakai.
CREEM_PRODUCT_ID=
# Dashboard Creem → Developers → Webhooks. URL: https://<domain>/api/pay/creem
CREEM_WEBHOOK_SECRET=
# true = paksa memakai test-api.creem.io (kalau prefix key tidak menandai mode uji)
# CREEM_TEST_MODE=true

# ── Simulasi ───────────────────────────────────────────────────────────────
# demo = SEMUA pembayaran disimulasikan (tidak ada uang berpindah). Hanya untuk mencoba alur;
# hapus sebelum situs dipromosikan. Tanpa ini: penyedia yang kuncinya terisi dipakai,
# yang belum diisi dimatikan di produksi (di lokal otomatis memakai simulasi).
# PAYMENT_PROVIDER=demo
